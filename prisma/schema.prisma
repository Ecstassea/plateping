generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  name           String
  phone          String?
  marketingOptIn  Boolean   @default(true)
  termsAcceptedAt DateTime?
  /// This person's own code for inviting friends. Not a fleet invite code:
  /// it credits the referrer, it does not share a workspace.
  referralCode    String?   @unique
  /// Set at sign-up so obvious referral farming is visible later.
  signupIp        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  memberships   Membership[]
  notifications Notification[]
  mailingList   MailingList?
  pushSubscriptions PushSubscription[]
  referralsMade Referral[]       @relation("referrer")
  referredBy    Referral?        @relation("referred")
  referralRewards ReferralReward[]

  @@index([email])
}

model Organization {
  id                   String    @id @default(cuid())
  name                 String
  type                 String    @default("personal")
  inviteCode           String    @unique
  plan                 String    @default("free")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripePriceId        String?
  subscriptionStatus   String    @default("inactive")
  currentPeriodEnd     DateTime?
  billingProvider      String?
  smilepayLastOrderRef String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  memberships Membership[]
  vehicles    Vehicle[]
  payments    Payment[]

  @@index([inviteCode])
}


model Payment {
  id               String    @id @default(cuid())
  organizationId   String
  orderReference   String    @unique
  plan             String
  amountCents      Int
  currency         String    @default("USD")
  status           String    @default("initiated")
  provider         String    @default("smilepay")
  providerTxnRef   String?
  rawStatus        String?
  paidAt           DateTime?
  periodEnd        DateTime?
  /// Who started the checkout (owner at the time).
  userId           String?
  /// Calendar months bought in this payment (Paynow periods; Smile&Pay is 1).
  months           Int       @default(1)
  /// Paynow's per-transaction status URL, stored at checkout so callbacks are
  /// confirmed against a URL we obtained ourselves.
  pollUrl          String?
  /// Human-readable reason when something needs a person to look at it.
  note             String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
}

model Membership {
  id             String   @id @default(cuid())
  role           String   @default("member")
  userId         String
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

model Vehicle {
  id              String   @id @default(cuid())
  plateNormalized String
  plateDisplay    String
  label           String?
  organizationId  String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, plateNormalized])
  @@index([plateNormalized])
  @@index([organizationId])
}

model Fine {
  id              String    @id @default(cuid())
  plateNormalized String
  plateDisplay    String
  offence         String
  location        String?
  source          String
  sourceUrl       String?
  statementTitle  String?
  listedAt        DateTime?
  estimatedUsd    String?
  status          String    @default("listed")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([plateNormalized, source, offence])
  @@index([plateNormalized])
}

model Notification {
  id              String    @id @default(cuid())
  userId          String
  organizationId  String
  plateNormalized String?
  title           String
  body            String
  readAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
}

model SyncRun {
  id          String   @id @default(cuid())
  source      String
  status      String
  platesFound Int      @default(0)
  newFines    Int      @default(0)
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MailingList {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  source         String
  userId         String?   @unique
  optedIn        Boolean   @default(true)
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([optedIn])
  @@index([source])
}

model RateLimit {
  id        String   @id @default(cuid())
  key       String   @unique
  hits      Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

/// Feature requests and problem reports from the app and the website.
model Feedback {
  id             String   @id @default(cuid())
  userId         String?
  organizationId String?
  email          String?
  kind           String   @default("feature")
  message        String
  page           String?
  userAgent      String?
  status         String   @default("new")
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([status])
}

/// One person who signed up through someone else's referral link.
model Referral {
  id             String   @id @default(cuid())
  referrerUserId String
  /// One row per new account, so a sign-up can never be counted twice.
  referredUserId String   @unique
  code           String
  referredEmail  String
  /// "personal" counts towards the ten-sign-up milestone; "company" pays its
  /// own larger reward as soon as it happens.
  kind           String   @default("personal")
  referredOrgName String?
  signupIp       String?
  /// Cleared by hand if a sign-up turns out to be fake; uncounted referrals
  /// do not move anyone towards a reward.
  counted        Boolean  @default(true)
  /// When the referred person first paid for a plan. Nothing is rewarded until
  /// this is set, so a signed-up account that never pays is worth nothing.
  qualifiedAt    DateTime?
  createdAt      DateTime @default(now())

  referrer User @relation("referrer", fields: [referrerUserId], references: [id], onDelete: Cascade)
  referred User @relation("referred", fields: [referredUserId], references: [id], onDelete: Cascade)

  @@index([referrerUserId, createdAt])
  @@index([code])
  @@index([qualifiedAt])
}

/// A free month earned by referring people. One row per milestone reached,
/// so the same ten sign-ups can never pay out twice.
model ReferralReward {
  id              String   @id @default(cuid())
  userId          String
  organizationId  String?
  /// "signups" for the ten-sign-up milestone, "company" for a referred company.
  kind            String   @default("signups")
  months          Int      @default(1)
  /// Which milestone this paid: 10, 20, 30 and so on. Null for a company reward.
  atReferralCount Int?
  /// Which referral paid this. Set for company rewards, and unique, so one
  /// referred company can never pay out twice.
  referralId      String?  @unique
  plan            String?
  periodEnd       DateTime?
  /// Set when the person owned no workspace at the time; claimed later.
  pending         Boolean  @default(false)
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, atReferralCount])
  @@index([userId])
}
