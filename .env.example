DATABASE_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"
AUTH_SECRET="replace-with-at-least-32-random-characters"
APP_URL="http://localhost:3000"
CRON_SECRET="replace-with-cron-secret"
MAIL_LIST_SECRET=""

# Local only. Never enable this on the live site.
ALLOW_DEMO_BILLING=""

# Smile&Pay (ZB Bank) — preferred for Zimbabwe plan subscriptions (not fine payments)
# Sandbox merchant: https://zbnet.zb.co.zw/wallet_sandbox_merchant/ → Settings → API Keys
SMILEPAY_ENV=sandbox
SMILEPAY_SANDBOX_KEY=
SMILEPAY_SANDBOX_SECRET=
SMILEPAY_PRODUCTION_KEY=
SMILEPAY_PRODUCTION_SECRET=
SMILEPAY_CURRENCY=USD
# Optional overrides (defaults derive from APP_URL)
SMILEPAY_RETURN_URL=
SMILEPAY_RESULT_URL=
# Optional hardening (callbacks are unsigned — status re-check is mandatory either way)
SMILEPAY_WEBHOOK_SECRET_PATH=
SMILEPAY_ALLOWED_IPS=
# SMILEPAY_LOG_REQUESTS=true

# Web Push (home-screen phone alerts)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
RESEND_API_KEY=""
ALERT_FROM_EMAIL="PlatePing <alerts@example.com>"

# Paynow (Zimbabwe) hosted checkout. From the Paynow dashboard: Receive Payments
# -> Integrations -> your web integration. APP_URL must be the public HTTPS
# address of the site, because Paynow posts payment results back to it.
PAYNOW_INTEGRATION_ID=""
PAYNOW_INTEGRATION_KEY=""
# The email of the Paynow merchant account. In test mode Paynow only lets this
# address complete a payment.
PAYNOW_MERCHANT_EMAIL=""
# "true" while the integration is still in test mode on Paynow; blank once live.
PAYNOW_TEST_MODE=""
# Which gateway the Plan screen offers when more than one is configured.
# Default order: Paynow, then Smile&Pay, then Stripe. Set to force one.
BILLING_PROVIDER=""

# Optional: Stripe subscriptions (used when no Zimbabwean gateway is configured)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_FAMILY=""
STRIPE_PRICE_FLEET=""
STRIPE_PRICE_FLEET_100=""
STRIPE_PRICE_FLEET_UNLIMITED=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
